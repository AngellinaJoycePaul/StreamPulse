# StreamPulse — environment variables
# Copy to .env and fill in real values.

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_STREAM=events:raw
REDIS_CONSUMER_GROUP=workers

# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=streampulse
POSTGRES_PASSWORD=streampulse_dev
POSTGRES_DB=streampulse

# API
API_HOST=0.0.0.0
API_PORT=8000

# Producer
PRODUCER_RATE_PER_SEC=10